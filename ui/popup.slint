// 右下角置顶通知弹窗:无框、置顶、固定 367×206(方角,不依赖窗口透明)
// 正文逐行渲染(行已在 Rust 侧折好),行间 spacing 4px;默认字号 14px,标题 16px

export struct BodyLine {
    text: styled-text,
    size: length,
}

export component PopupWindow inherits Window {
    // title 仅作 WM/任务栏/测试识别用,无框窗口不显示标题
    title: "x-notify-service";
    no-frame: true;
    // 置顶在 Rust 侧 show 之后再置位:winit 的 X11 实现经 ClientMessage 请求 WM
    // 改状态,映射前发送会被 WM 丢弃(EWMH 语义),故初始 false、显示后翻 true
    always-on-top: raise-above;
    in property <bool> raise-above: false;
    background: #ffffff;
    icon: @image-url("../assets/icons/hicolor/x-notify-service-128.png");
    width: 367px;
    height: 206px;

    in property <string> notif-title: "通知";
    in property <[BodyLine]> body-lines: [];
    callback close-requested();

    // 入场动画:从右侧轻微滑入
    property <length> slide: 26px;
    init => {
        root.slide = 0px;
    }

    // 点击弹窗任意位置关闭
    TouchArea {
        clicked => {
            root.close-requested();
        }
    }

    // 卡片本体(方角 + 描边)
    Rectangle {
        x: root.slide;
        width: parent.width;
        height: parent.height;
        background: #ffffff;
        border-width: 1px;
        border-color: #e4e6eb;
        animate x {
            duration: 220ms;
            easing: ease-out;
        }

        VerticalLayout {
            x: 20px;
            width: parent.width - 32px;
            y: 16px;
            height: parent.height - 32px;
            spacing: 4px;

            HorizontalLayout {
                height: 26px;
                Text {
                    text: root.notif-title;
                    color: #1f2329;
                    font-size: 16px;
                    font-weight: 700;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 28px;
                    Rectangle {
                        x: 4px;
                        y: 3px;
                        width: 20px;
                        height: 20px;
                        border-radius: 10px;
                        background: touch.has-hover ? #eef0f3 : transparent;
                        Text {
                            text: "×";
                            color: #9aa2ad;
                            font-size: 16px;
                        }
                        touch := TouchArea {
                            clicked => {
                                root.close-requested();
                            }
                        }
                    }
                }
            }

            // 正文:逐行渲染,行高 = 字号 × 1.6
            for line in root.body-lines: StyledText {
                text: line.text;
                default-color: #5f6672;
                default-font-size: line.size;
                height: line.size * 1.6;
                vertical-alignment: top;
            }
        }
    }
}
